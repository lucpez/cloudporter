resource "azurerm_network_interface" "{{ tf_name }}" {
  name                = "{{ tf_name }}-nic"
  location            = azurerm_resource_group.{{ rg_tf_name }}.location
  resource_group_name = azurerm_resource_group.{{ rg_tf_name }}.name

  ip_configuration {
    name                          = "internal"
    subnet_id                     = tolist(azurerm_virtual_network.{{ rg_tf_name }}.subnet)[0].id
    private_ip_address_allocation = "Dynamic"
  }
}

resource "azurerm_linux_virtual_machine" "{{ tf_name }}" {
  name                = "{{ tf_name }}"
  resource_group_name = azurerm_resource_group.{{ rg_tf_name }}.name
  location            = azurerm_resource_group.{{ rg_tf_name }}.location
  size                = "{{ vm_size }}"
  computer_name       = "{{ computer_name }}"
  admin_username      = "adminuser"

  network_interface_ids = [
    azurerm_network_interface.{{ tf_name }}.id,
  ]

  admin_ssh_key {
    username   = "adminuser"
    public_key = "{{ ssh_pub_key }}"
  }

  os_disk {
    caching              = "ReadWrite"
    storage_account_type = "Standard_LRS"
  }

  source_image_reference {
    publisher = "{{ publisher }}"
    offer     = "{{ offer }}"
    sku       = "{{ sku }}"
    version   = "latest"
  }
}
