resource "azurerm_mysql_flexible_server" "{{ tf_name }}" {
  name                   = "{{ server_name }}"
  resource_group_name    = azurerm_resource_group.{{ rg_tf_name }}.name
  location               = azurerm_resource_group.{{ rg_tf_name }}.location
  administrator_login    = "dbadmin"
  administrator_password = var.db_password
  sku_name               = "{{ sku_name }}"
  version                = "{{ version }}"

  storage {
    size_gb = {{ storage_gb }}
  }
}
