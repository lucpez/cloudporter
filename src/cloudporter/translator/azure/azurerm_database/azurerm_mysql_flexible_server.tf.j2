resource "random_string" "{{ tf_name }}_suffix" {
  length  = 6
  special = false
  upper   = false
  keepers = {
    server_name = "{{ server_name }}"
  }
}

resource "azurerm_mysql_flexible_server" "{{ tf_name }}" {
  name                   = "{{ server_name }}-${random_string.{{ tf_name }}_suffix.result}"
  resource_group_name    = azurerm_resource_group.{{ rg_tf_name }}.name
  location               = azurerm_resource_group.{{ rg_tf_name }}.location
  administrator_login    = "dbadmin"
  administrator_password = var.db_password
  sku_name               = "{{ sku_name }}"
  version                = "{{ version }}"

  storage {
    size_gb = {{ storage_gb }}
  }
}

resource "azurerm_mysql_flexible_server_firewall_rule" "{{ tf_name }}_allow_all" {
  name                = "allow-all"
  resource_group_name = azurerm_resource_group.{{ rg_tf_name }}.name
  server_name         = azurerm_mysql_flexible_server.{{ tf_name }}.name
  start_ip_address    = "0.0.0.0"
  end_ip_address      = "255.255.255.255"
}
