resource "aws_db_instance" "{{ tf_name }}" {
  identifier        = "{{ db_name }}"
  engine            = "{{ engine }}"
  engine_version    = "{{ engine_version }}"
  instance_class    = "{{ instance_class }}"
  allocated_storage = {{ storage_gb }}
  username          = "dbadmin"
  password          = var.db_password
  skip_final_snapshot = true
}
